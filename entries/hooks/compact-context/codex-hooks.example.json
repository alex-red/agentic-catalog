{
  "description": "Optional compact-context hook for a trusted local Codex project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compact-context/restore.py\" --harness codex",
            "timeout": 8,
            "additionalContextLimit": 2000
          }
        ]
      }
    ]
  }
}
