{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/compact-context/restore.py"
            ],
            "timeout": 8
          }
        ]
      }
    ]
  }
}
