{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files-and-commands/guard.sh"
            ],
            "timeout": 60
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ]
  }
}
