{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/protect-files-and-commands/guard.sh\"",
            "timeout": 60
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ]
  }
}
