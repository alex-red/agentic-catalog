{
  "description": "Optional subagent-budget hook for a trusted local Codex project.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent-budget/budget.py\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
