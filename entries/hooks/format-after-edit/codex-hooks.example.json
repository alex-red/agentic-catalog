{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/format-after-edit/format.py\"",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
