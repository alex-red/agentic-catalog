{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "rule": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "fixture": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "triggers": {
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectation": {
            "enum": [
              "activate",
              "ignore",
              "clarify"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criteria": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Pass condition for the model-judged clarify check; defaults to asking for the missing information before acting."
          }
        },
        "required": [
          "expectation",
          "prompt"
        ],
        "if": {
          "type": "object",
          "properties": {
            "expectation": {
              "enum": [
                "activate",
                "ignore"
              ]
            }
          },
          "required": [
            "expectation"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "criteria": false
          }
        }
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "command"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "command"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id"
  ],
  "oneOf": [
    {
      "required": [
        "skill",
        "triggers"
      ],
      "properties": {
        "skill": {
          "$ref": "#/properties/skill"
        },
        "rule": {
          "$ref": "#/properties/rule"
        },
        "triggers": {
          "allOf": [
            {
              "$ref": "#/properties/triggers"
            },
            {
              "type": "array",
              "minItems": 3
            }
          ]
        }
      },
      "not": {
        "properties": {
          "rule": {}
        },
        "required": [
          "rule"
        ]
      }
    },
    {
      "required": [
        "rule",
        "fixture",
        "request",
        "grader",
        "acceptance"
      ],
      "properties": {
        "rule": {
          "$ref": "#/properties/rule"
        },
        "skill": {
          "$ref": "#/properties/skill"
        },
        "fixture": {
          "$ref": "#/properties/fixture"
        },
        "request": {
          "$ref": "#/properties/request"
        },
        "grader": {
          "$ref": "#/properties/grader"
        },
        "runtime": {
          "$ref": "#/properties/runtime"
        },
        "acceptance": {
          "$ref": "#/properties/acceptance"
        },
        "triggers": {
          "allOf": [
            {
              "$ref": "#/properties/triggers"
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        }
      },
      "not": {
        "properties": {
          "skill": {}
        },
        "required": [
          "skill"
        ]
      }
    }
  ],
  "dependencies": {
    "fixture": [
      "request",
      "acceptance",
      "grader"
    ],
    "grader": [
      "fixture"
    ],
    "runtime": [
      "fixture"
    ],
    "request": [
      "fixture"
    ]
  }
}
