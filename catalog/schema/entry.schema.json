{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalog entry",
  "description": "Metadata for one catalog entry, stored as entries/<type>s/<id>/entry.yaml.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "maxLength": 64
    },
    "https": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "axis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      },
      "uniqueItems": true
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "url": {
          "$ref": "#/definitions/https"
        }
      },
      "required": [
        "title",
        "url"
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/definitions/slug"
    },
    "type": {
      "enum": [
        "skill",
        "rule",
        "workflow",
        "hook",
        "subagent",
        "mcp",
        "plugin"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "\\S"
    },
    "useWhen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/tag"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 8
    },
    "hosts": {
      "description": "any = portable through an open format (Agent Skills, AGENTS.md, MCP); otherwise the hosts it was written for.",
      "type": "array",
      "items": {
        "enum": [
          "any",
          "claude-code",
          "codex"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "experimental": {
      "const": true,
      "description": "Interesting but unproven: listed apart from the established entries and recommended only when the user asks for experimental options."
    },
    "custom": {
      "const": true,
      "description": "A bespoke house item written for this catalog's owner rather than selected from outside research. Listed in its own section; still rated honestly."
    },
    "featured": {
      "const": true,
      "description": "Highlighted in the browser's Featured group as well as under its own type. Does not change llms.txt or ratings."
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usefulness": {
          "$ref": "#/definitions/axis",
          "description": "How often and how much it helps a typical software project."
        },
        "quality": {
          "$ref": "#/definitions/axis",
          "description": "Clarity, proportionality, and safety of the content."
        },
        "portability": {
          "$ref": "#/definitions/axis",
          "description": "How easily it works across hosts and projects."
        },
        "novelty": {
          "$ref": "#/definitions/axis",
          "description": "Value beyond host built-ins and default model behavior."
        },
        "evidence": {
          "description": "reviewed: read and judged; used: used in a real project; tested: trigger or load checks recorded; evaluated: matched outcome runs recorded.",
          "enum": [
            "reviewed",
            "used",
            "tested",
            "evaluated"
          ]
        },
        "reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        }
      },
      "required": [
        "usefulness",
        "quality",
        "portability",
        "novelty",
        "evidence",
        "reviewed",
        "notes"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "original: written here; adapted: written here from cited inspiration; vendored: pinned upstream copy; linked: upstream only.",
          "enum": [
            "original",
            "adapted",
            "vendored",
            "linked"
          ]
        },
        "url": {
          "$ref": "#/definitions/https"
        },
        "path": {
          "$ref": "#/definitions/text"
        },
        "revision": {
          "$ref": "#/definitions/sha"
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the upstream content was copied (vendored) or read (linked) at the pinned revision."
        },
        "license": {
          "$ref": "#/definitions/text"
        },
        "author": {
          "$ref": "#/definitions/text"
        },
        "notes": {
          "$ref": "#/definitions/text"
        }
      },
      "required": [
        "kind",
        "license"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "vendored"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "url",
              "revision",
              "author",
              "retrieved"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "retrieved": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "linked"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "url",
              "author",
              "retrieved"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "retrieved": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "inspiredBy": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/link"
      },
      "minItems": 1
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides the type's default install steps.",
      "properties": {
        "claude-code": {
          "$ref": "#/definitions/text"
        },
        "codex": {
          "$ref": "#/definitions/text"
        },
        "any": {
          "$ref": "#/definitions/text"
        },
        "notes": {
          "$ref": "#/definitions/text"
        }
      },
      "minProperties": 1
    },
    "overlap": {
      "$ref": "#/definitions/text",
      "description": "What hosts or other entries already cover."
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/slug"
      },
      "uniqueItems": true
    },
    "evaluationCases": {
      "$ref": "#/definitions/paths"
    },
    "evidence": {
      "$ref": "#/definitions/paths"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "type",
    "title",
    "summary",
    "useWhen",
    "tags",
    "hosts",
    "rating",
    "source"
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "adapted"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "inspiredBy"
        ],
        "properties": {
          "inspiredBy": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "object",
            "properties": {
              "evidence": {
                "enum": [
                  "used",
                  "tested",
                  "evaluated"
                ]
              }
            },
            "required": [
              "evidence"
            ]
          }
        },
        "required": [
          "rating"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "plugin"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "linked"
              }
            }
          }
        }
      }
    }
  ]
}
