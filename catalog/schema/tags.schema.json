{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tag vocabulary",
  "description": "Controlled vocabulary for entry tags, stored as catalog/tags.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$", "maxLength": 64 },
          "label": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
          "facet": { "enum": ["topic", "task", "technology", "keyword"] },
          "definition": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": ["id", "label", "facet", "definition"]
      }
    }
  },
  "required": ["schemaVersion", "terms"]
}
