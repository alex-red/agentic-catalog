{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "expectation": {
                  "enum": [
                    "activate",
                    "ignore",
                    "clarify"
                  ]
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "expectation",
                "prompt"
              ]
            }
          }
        },
        "required": [
          "skill",
          "triggers"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "skills"
  ]
}
