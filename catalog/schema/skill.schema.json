{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 1024
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "compatibility": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 500
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "allowed-tools": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "argument-hint": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Claude Code: hint shown for the skill's slash-command arguments."
    },
    "disable-model-invocation": {
      "type": "boolean",
      "description": "Claude Code: true makes the skill run only when the user invokes it."
    }
  },
  "required": [
    "name",
    "description"
  ]
}
