{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "maturity": {
      "enum": [
        "experimental",
        "candidate",
        "stable"
      ]
    },
    "maintainer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "oneOf": [
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "original"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "adapted"
            },
            "upstream": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https://"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "notices": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "upstream",
            "revision",
            "license",
            "notices",
            "notes"
          ]
        }
      ]
    },
    "evaluationCases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "category",
    "tags",
    "maturity",
    "maintainer",
    "provenance",
    "evaluationCases",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "maturity": {
            "enum": [
              "candidate",
              "stable"
            ]
          }
        },
        "required": [
          "maturity"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
