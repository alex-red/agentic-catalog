{
  "name": "agentic-rules",
  "version": "0.0.0",
  "private": true,
  "description": "A curated, portable library of engineering guidance for coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "validate": "bun scripts/validate.ts",
    "catalog:build": "bun scripts/catalog.ts --write",
    "catalog:check": "bun scripts/catalog.ts --check",
    "rules:preview": "bun scripts/rules-preview.ts",
    "wiki:build": "bun scripts/wiki-build.ts",
    "wiki:dev": "bun scripts/wiki-serve.ts",
    "lint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run validate && bun run catalog:check && bun test && bun run wiki:build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "markdownlint-cli2": "0.23.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
