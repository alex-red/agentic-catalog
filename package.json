{
  "name": "agentic-rules",
  "version": "0.0.2",
  "private": true,
  "description": "A curated, rated catalog of rules, skills, workflows, hooks, subagents, and MCP servers for coding agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ban-red/agentic-rules"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "validate": "bun scripts/validate.ts",
    "catalog:build": "bun scripts/catalog.ts --write",
    "catalog:check": "bun scripts/catalog.ts --check",
    "catalog:freshness": "bun scripts/catalog-freshness.ts",
    "rules:preview": "bun scripts/rules-preview.ts",
    "dev": "vite",
    "site:build": "vite build",
    "lint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "test": "bun test",
    "eval:triggers": "bun scripts/eval-triggers.ts",
    "eval:run": "bun scripts/eval-run.ts",
    "plugin:validate": "claude plugin validate . --strict",
    "eval:skills": "bun scripts/eval-skills.ts",
    "check": "bun run typecheck && bun run lint && bun run validate && bun run catalog:check && bun test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "markdownlint-cli2": "0.23.3",
    "mdast-util-from-markdown": "2.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
